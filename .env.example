# Copy to .env and fill in on your own machine. Nothing here is read by the CDK app;
# the simulator takes these as command-line flags or environment variables.
AWS_IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.eu-central-1.amazonaws.com
AWS_REGION=eu-central-1
DEVICE_ID=hive-SIM001
DEVICE_CERT=simulator/certs/hive-SIM001.pem.crt
DEVICE_KEY=simulator/certs/hive-SIM001.private.key
ROOT_CA=simulator/certs/AmazonRootCA1.pem
